APP_NAME="Assignment Submission App"
APP_ENV=production
APP_KEY=base64:MqzqUgfX2nDeSppsOO2g3mLg2WbrOp54BFUqiJPljTc=
APP_DEBUG=false
APP_URL=http://laravel.192.168.1.149.sslip.io

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=error

# -------------------------------------------------------------
# DATABASE: Option 1 - SQLite (Recommended on Coolify if using persistent volume)
# Mount a Persistent Storage in Coolify: /var/www/html/database
# -------------------------------------------------------------
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/database.sqlite

# -------------------------------------------------------------
# DATABASE: Option 2 - PostgreSQL (If created in Coolify)
# If you add a PostgreSQL resource in your Coolify project:
# DB_CONNECTION=pgsql
# DB_HOST=postgres       # or the Coolify internal container name
# DB_PORT=5432
# DB_DATABASE=laravel
# DB_USERNAME=coolify
# DB_PASSWORD=your_password
# -------------------------------------------------------------

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Container startup flags
RUN_MIGRATIONS=true
RUN_SEED=true
